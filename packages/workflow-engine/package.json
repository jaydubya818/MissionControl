{
  "name": "@mission-control/workflow-engine",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent workflow execution engine inspired by Antfarm",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./verification": {
      "types": "./dist/verification.d.ts",
      "import": "./dist/verification.js",
      "default": "./dist/verification.js"
    },
    "./verification-authority": {
      "types": "./dist/verificationAuthority.d.ts",
      "import": "./dist/verificationAuthority.js",
      "default": "./dist/verificationAuthority.js"
    },
    "./verification-identity": {
      "types": "./dist/verificationIdentity.d.ts",
      "import": "./dist/verificationIdentity.js",
      "default": "./dist/verificationIdentity.js"
    },
    "./verification-currentness": {
      "types": "./dist/verificationCurrentness.d.ts",
      "import": "./dist/verificationCurrentness.js",
      "default": "./dist/verificationCurrentness.js"
    },
    "./verification-subject": {
      "types": "./dist/verificationSubject.d.ts",
      "import": "./dist/verificationSubject.js",
      "default": "./dist/verificationSubject.js"
    },
    "./verification-plan": {
      "types": "./dist/verificationPlan.d.ts",
      "import": "./dist/verificationPlan.js",
      "default": "./dist/verificationPlan.js"
    },
    "./verification-independence": {
      "types": "./dist/verificationIndependence.d.ts",
      "import": "./dist/verificationIndependence.js",
      "default": "./dist/verificationIndependence.js"
    },
    "./verification-decision": {
      "types": "./dist/verificationDecision.d.ts",
      "import": "./dist/verificationDecision.js",
      "default": "./dist/verificationDecision.js"
    },
    "./harness-contract": {
      "types": "./dist/harnessContract.d.ts",
      "import": "./dist/harnessContract.js",
      "default": "./dist/harnessContract.js"
    },
    "./cost-enforcement": {
      "types": "./dist/factoryCostEnforcement.d.ts",
      "import": "./dist/factoryCostEnforcement.js",
      "default": "./dist/factoryCostEnforcement.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mission-control/shared": "workspace:*",
    "@mission-control/state-machine": "workspace:*",
    "@mission-control/policy-engine": "workspace:*",
    "mustache": "^4.2.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/mustache": "^4.2.5",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  }
}
