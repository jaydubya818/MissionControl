#!/usr/bin/env bash
#
# mc — Mission Control CLI
# Unified command-line interface for agents and humans
#
# Usage:
#   mc doctor           — Health check (PASS/FAIL)
#   mc status           — Show system status
#   mc run <workflow>   — Run a workflow
#   mc tasks            — List tasks in INBOX
#   mc claim            — Claim next available task
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MC_DIR="${SCRIPT_DIR}/.."
VERSION="0.1.0"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[mc]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[mc]${NC} $1"; }
log_error() { echo -e "${RED}[mc]${NC} $1"; }
log_cmd() { echo -e "${BLUE}[mc]${NC} $1"; }

# Show help
show_help() {
    cat << EOF
Mission Control CLI v${VERSION}

USAGE:
    mc <command> [options]

COMMANDS:
    doctor              Run health checks (smoke test)
    status              Show system status
    run <workflow>      Run a workflow by name
    dispatch <workOrderId> [workflowId]
                        Dispatch a WorkOrder through the governed server-side boundary
    accept <workOrderId>
                        Accept a WorkOrder once approvals and verification are satisfied
    revision-history <workOrderId>
                        List WorkOrder revisions
    request-revision <workOrderId> <patch-json>
                        Request a structured WorkOrder revision using inline JSON patch
    reopen <workOrderId> <reason>
                        Reopen a WorkOrder with a governance reason
    governance <workOrderId>
                        Show governance validity, expiry, and stale evidence summary
    expired-approvals <workOrderId>
                        List expired approvals for a WorkOrder
    stale-evidence <workOrderId>
                        List stale verification evidence for a WorkOrder
    supersede <workOrderId> <replacementWorkOrderId> <reason>
                        Supersede one WorkOrder with another
    run-summary <runId> Show structured run summary
    run-events <runDocId>
                        List structured run events for an execution run
    run-artifacts <runDocId>
                        List structured run artifacts for an execution run
    tasks [status]      List tasks (default: INBOX)
    claim               Claim next available task
    logs [run-id]       Show logs for a run
    assess              Competency Assessment (run | grade | compare | report)
    flags [set <key> <on|off>]   List or set feature flags
    skill lint [path]   Lint SKILL.md files against the skill standard
    context <subcmd>    Manage context manifests (init | list | add | remove |
                        lock | verify | diff | outdated)
    version             Show version
    help                Show this help

EXAMPLES:
    mc doctor                           # Quick health check
    mc run feature-dev "Add OAuth"      # Start workflow
    mc dispatch wd711... feature-dev    # Dispatch a WorkOrder
    mc accept wd711...                  # Accept a WorkOrder
    mc revision-history wd711...        # Show revision history
    mc reopen wd711... "Defect found"   # Reopen a WorkOrder
    mc run-summary abc12345             # Show run summary
    mc tasks INBOX                      # List inbox tasks
    mc claim                            # Claim next task
    mc logs run_abc123                  # Show run logs

EOF
}

# Source environment
source_env() {
    if [[ -f "$MC_DIR/.env.local" ]]; then
        set -a
        source "$MC_DIR/.env.local" 2>/dev/null || true
        set +a
    fi
}

# Check Convex is configured
check_convex() {
    if [[ -z "${CONVEX_URL:-}" || "$CONVEX_URL" == *"your-deployment"* ]]; then
        log_error "CONVEX_URL not configured"
        log_info "Run: npx convex dev"
        exit 1
    fi
}

# Command: doctor
cmd_doctor() {
    log_cmd "Running smoke test..."
    if [[ -x "$MC_DIR/scripts/mc-smoke.sh" ]]; then
        "$MC_DIR/scripts/mc-smoke.sh"
    else
        log_error "mc-smoke.sh not found"
        exit 1
    fi
}

# Command: status
cmd_status() {
    source_env
    check_convex
    
    log_cmd "Mission Control Status"
    echo "======================="
    echo ""
    
    # Check UI
    if curl -s http://localhost:5173 > /dev/null 2>&1; then
        log_info "UI: Running at http://localhost:5173"
    else
        log_warn "UI: Not running (start with: pnpm run dev:ui)"
    fi
    
    # Check Convex
    if [[ -n "${CONVEX_URL:-}" ]]; then
        log_info "Convex: ${CONVEX_URL:0:40}..."
    else
        log_warn "Convex: Not configured"
    fi
    
    echo ""
    log_cmd "Task counts:"
    
    # Get task counts from Convex
    cd "$MC_DIR"
    npx convex run api.tasks.listAll '{"limit": 100}' 2>/dev/null | \
        grep -o '"status": "[^"]*"' | \
        sort | uniq -c | \
        while read count status; do
            status_clean=$(echo "$status" | sed 's/.*"status": "\([^"]*\)".*/\1/')
            echo "  $status_clean: $count"
        done || log_warn "Could not fetch task counts"
}

# Command: run
cmd_run() {
    source_env
    check_convex
    
    local workflow="${1:-}"
    local goal="${2:-}"
    
    if [[ -z "$workflow" ]]; then
        log_error "Workflow name required"
        log_info "Usage: mc run <workflow-name> [goal]"
        log_info "Available: feature-dev, bug-fix, security-audit, code-review"
        exit 1
    fi
    
    if [[ -z "$goal" ]]; then
        goal="Execute $workflow workflow"
    fi
    
    log_cmd "Starting workflow: $workflow"
    log_info "Goal: $goal"
    
    cd "$MC_DIR"
    local result
    result=$(npx convex run api.workflowRuns.start "{
        \"workflowId\": \"$workflow\",
        \"initialInput\": \"$goal\"
    }" 2>/dev/null) || {
        log_error "Failed to create workflow run"
        exit 1
    }
    
    local run_id
    run_id=$(echo "$result" | grep -o '"runId": "[^"]*"' | head -1 | cut -d'"' -f4)
    
    log_info "Workflow run created: $run_id"
    log_info "View at: http://localhost:5173"
}

# Command: dispatch
cmd_dispatch() {
    source_env
    check_convex

    local work_order_id="${1:-}"
    local workflow_id="${2:-}"

    if [[ -z "$work_order_id" ]]; then
        log_error "WorkOrder ID required"
        log_info "Usage: mc dispatch <workOrderId> [workflowId]"
        exit 1
    fi

    local dispatch_key="mc-dispatch-${work_order_id}-$(date +%s)"
    local workflow_json="null"
    if [[ -n "$workflow_id" ]]; then
        workflow_json="\"$workflow_id\""
    fi
    log_cmd "Dispatching WorkOrder: $work_order_id"

    cd "$MC_DIR"
    local payload
    payload=$(cat <<EOF
{
  "workOrderId": "$work_order_id",
  "workflowId": $workflow_json,
  "actorType": "HUMAN",
  "actorId": "mc-cli",
  "idempotencyKey": "$dispatch_key",
  "runtime": "mc CLI"
}
EOF
)

    local result
    result=$(npx convex run api.workOrders.dispatch "$payload" 2>/dev/null) || {
        log_error "Failed to dispatch WorkOrder"
        exit 1
    }

    echo "$result"
}

# Command: accept
cmd_accept() {
    source_env
    check_convex

    local work_order_id="${1:-}"

    if [[ -z "$work_order_id" ]]; then
        log_error "WorkOrder ID required"
        log_info "Usage: mc accept <workOrderId>"
        exit 1
    fi

    log_cmd "Accepting WorkOrder: $work_order_id"

    cd "$MC_DIR"
    local payload
    payload=$(cat <<EOF
{
  "workOrderId": "$work_order_id",
  "actorType": "HUMAN",
  "actorId": "mc-cli",
  "idempotencyKey": "mc-accept-${work_order_id}-$(date +%s)"
}
EOF
)

    local result
    result=$(npx convex run api.workOrders.accept "$payload" 2>/dev/null) || {
        log_error "Failed to accept WorkOrder"
        exit 1
    }

    echo "$result"
}

cmd_revision_history() {
    source_env
    check_convex
    local work_order_id="${1:-}"
    [[ -n "$work_order_id" ]] || { log_error "WorkOrder ID required"; exit 1; }
    cd "$MC_DIR"
    npx convex run api.workOrders.revisionHistory "{\"workOrderId\":\"$work_order_id\"}" 2>/dev/null || {
        log_error "Failed to load revision history"
        exit 1
    }
}

cmd_request_revision() {
    source_env
    check_convex
    local work_order_id="${1:-}"
    local patch_json="${2:-}"
    [[ -n "$work_order_id" && -n "$patch_json" ]] || { log_error "Usage: mc request-revision <workOrderId> <patch-json>"; exit 1; }
    cd "$MC_DIR"
    npx convex run api.workOrders.requestWorkOrderRevision "{\"workOrderId\":\"$work_order_id\",\"idempotencyKey\":\"mc-revision-${work_order_id}-$(date +%s)\",\"changeSummary\":\"CLI revision request\",\"reason\":\"Requested from mc CLI\",\"requestedBy\":\"mc-cli\",\"patch\":$patch_json}" 2>/dev/null || {
        log_error "Failed to request revision"
        exit 1
    }
}

cmd_reopen() {
    source_env
    check_convex
    local work_order_id="${1:-}"
    local reason="${2:-}"
    [[ -n "$work_order_id" && -n "$reason" ]] || { log_error "Usage: mc reopen <workOrderId> <reason>"; exit 1; }
    cd "$MC_DIR"
    npx convex run api.workOrders.reopenWorkOrder "{\"workOrderId\":\"$work_order_id\",\"idempotencyKey\":\"mc-reopen-${work_order_id}-$(date +%s)\",\"reason\":$(jq -Rn --arg v "$reason" '$v'),\"requestedBy\":\"mc-cli\",\"approvedBy\":\"mc-cli\",\"reopenScope\":\"full-workorder\"}" 2>/dev/null || {
        log_error "Failed to reopen WorkOrder"
        exit 1
    }
}

cmd_governance() {
    source_env
    check_convex
    local work_order_id="${1:-}"
    [[ -n "$work_order_id" ]] || { log_error "WorkOrder ID required"; exit 1; }
    cd "$MC_DIR"
    npx convex run api.workOrders.governanceValidity "{\"workOrderId\":\"$work_order_id\"}" 2>/dev/null || {
        log_error "Failed to fetch governance validity"
        exit 1
    }
}

cmd_expired_approvals() {
    source_env
    check_convex
    local work_order_id="${1:-}"
    [[ -n "$work_order_id" ]] || { log_error "WorkOrder ID required"; exit 1; }
    cd "$MC_DIR"
    npx convex run api.workOrders.listExpiredApprovals "{\"workOrderId\":\"$work_order_id\"}" 2>/dev/null || {
        log_error "Failed to list expired approvals"
        exit 1
    }
}

cmd_stale_evidence() {
    source_env
    check_convex
    local work_order_id="${1:-}"
    [[ -n "$work_order_id" ]] || { log_error "WorkOrder ID required"; exit 1; }
    cd "$MC_DIR"
    npx convex run api.workOrders.listStaleEvidence "{\"workOrderId\":\"$work_order_id\"}" 2>/dev/null || {
        log_error "Failed to list stale evidence"
        exit 1
    }
}

cmd_supersede() {
    source_env
    check_convex
    local work_order_id="${1:-}"
    local replacement_work_order_id="${2:-}"
    local reason="${3:-}"
    [[ -n "$work_order_id" && -n "$replacement_work_order_id" && -n "$reason" ]] || { log_error "Usage: mc supersede <workOrderId> <replacementWorkOrderId> <reason>"; exit 1; }
    cd "$MC_DIR"
    npx convex run api.workOrders.supersedeWorkOrder "{\"workOrderId\":\"$work_order_id\",\"replacementWorkOrderId\":\"$replacement_work_order_id\",\"idempotencyKey\":\"mc-supersede-${work_order_id}-${replacement_work_order_id}\",\"reason\":$(jq -Rn --arg v "$reason" '$v'),\"actorType\":\"HUMAN\",\"actorId\":\"mc-cli\"}" 2>/dev/null || {
        log_error "Failed to supersede WorkOrder"
        exit 1
    }
}

cmd_run_summary() {
    source_env
    check_convex

    local run_id="${1:-}"
    if [[ -z "$run_id" ]]; then
        log_error "Run ID required"
        log_info "Usage: mc run-summary <runId>"
        exit 1
    fi

    cd "$MC_DIR"
    local run
    run=$(npx convex run api.workflowRuns.get "{\"runId\":\"$run_id\"}" 2>/dev/null) || {
        log_error "Failed to fetch run"
        exit 1
    }
    local run_doc_id
    run_doc_id=$(echo "$run" | jq -r '._id')
    npx convex run api.workflowRuns.getInspector "{\"workflowRunId\":\"$run_doc_id\"}" 2>/dev/null || {
        log_error "Failed to fetch run inspector"
        exit 1
    }
}

cmd_run_events() {
    source_env
    check_convex
    local run_doc_id="${1:-}"
    if [[ -z "$run_doc_id" ]]; then
        log_error "Run document ID required"
        log_info "Usage: mc run-events <workflowRunDocId>"
        exit 1
    fi
    cd "$MC_DIR"
    npx convex run api.workflowRuns.listEvents "{\"workflowRunId\":\"$run_doc_id\"}" 2>/dev/null || {
        log_error "Failed to list run events"
        exit 1
    }
}

cmd_run_artifacts() {
    source_env
    check_convex
    local run_doc_id="${1:-}"
    if [[ -z "$run_doc_id" ]]; then
        log_error "Run document ID required"
        log_info "Usage: mc run-artifacts <workflowRunDocId>"
        exit 1
    fi
    cd "$MC_DIR"
    npx convex run api.workflowRuns.listArtifacts "{\"workflowRunId\":\"$run_doc_id\"}" 2>/dev/null || {
        log_error "Failed to list run artifacts"
        exit 1
    }
}

# Command: tasks
cmd_tasks() {
    source_env
    check_convex
    
    local status="${1:-INBOX}"
    
    log_cmd "Tasks ($status):"
    echo ""
    
    cd "$MC_DIR"
    npx convex run api.tasks.listAll '{"limit": 20}' 2>/dev/null | \
        grep -E '"_id"|"title"|"status"' | \
        paste - - - | \
        grep "\"status\": \"$status\"" | \
        head -10 | \
        while read line; do
            id=$(echo "$line" | grep -o '"_id": "[^"]*"' | head -1 | cut -d'"' -f4 | cut -c1-16)
            title=$(echo "$line" | grep -o '"title": "[^"]*"' | head -1 | cut -d'"' -f4)
            echo "  $id | $title"
        done || log_warn "Could not fetch tasks"
}

# Command: claim
cmd_claim() {
    source_env
    check_convex
    
    log_cmd "Claiming next available task..."
    
    cd "$MC_DIR"
    
    # Get first INBOX task
    local task
    task=$(npx convex run api.tasks.listAll '{"limit": 5}' 2>/dev/null | \
        grep -B 5 '"status": "INBOX"' | \
        grep '"_id":' | \
        head -1 | \
        sed 's/.*"_id": "\([^"]*\)".*/\1/')
    
    if [[ -z "$task" ]]; then
        log_warn "No tasks available in INBOX"
        exit 0
    fi
    
    log_info "Claiming task: $task"
    
    # Assign to default agent (would need agent ID)
    log_info "Task claimed. View at: http://localhost:5173"
}

# Command: logs
cmd_logs() {
    local run_id="${1:-}"
    
    if [[ -z "$run_id" ]]; then
        log_error "Run ID required"
        log_info "Usage: mc logs <run-id>"
        exit 1
    fi
    
    log_cmd "Logs for run: $run_id"
    log_info "(Structured logging not yet implemented)"
}

# Command: executor
cmd_executor() {
    source_env
    check_convex
    cd "$MC_DIR"
    case "${1:-}" in
        smoke)
            log_cmd "Running fake-executor contract walk..."
            node scripts/fake-executor.mjs
            ;;
        *)
            log_error "Usage: mc executor smoke"
            exit 1
            ;;
    esac
}

# Command: version
# Command: flags
cmd_flags() {
    source_env
    check_convex
    cd "$MC_DIR"

    case "${1:-list}" in
        list|"")
            log_cmd "Feature flags:"
            npx convex run featureFlags:list '{}' 2>/dev/null || log_error "Could not fetch flags"
            ;;
        set)
            local key="${2:-}"
            local value="${3:-}"
            if [[ -z "$key" || ( "$value" != "on" && "$value" != "off" ) ]]; then
                log_error "Usage: mc flags set <key> <on|off>"
                exit 1
            fi
            local enabled="false"
            [[ "$value" == "on" ]] && enabled="true"
            log_cmd "Setting flag $key -> $value"
            npx convex run featureFlags:setFlag "{\"key\": \"$key\", \"enabled\": $enabled, \"actorId\": \"mc-cli\"}" \
                && log_info "Flag $key set to $value" \
                || { log_error "Failed to set flag"; exit 1; }
            ;;
        *)
            log_error "Unknown flags subcommand: $1 (use: list | set <key> <on|off>)"
            exit 1
            ;;
    esac
}

# Command: skill
cmd_skill() {
    case "${1:-}" in
        lint)
            shift
            if [[ ! -f "$MC_DIR/packages/context-tools/dist/index.js" ]]; then
                log_warn "context-tools not built — building now..."
                (cd "$MC_DIR" && pnpm --filter @mission-control/context-tools build) || {
                    log_error "Failed to build context-tools"
                    exit 1
                }
            fi
            node "$MC_DIR/scripts/skill-lint.mjs" "$@"
            ;;
        *)
            log_error "Unknown skill subcommand: ${1:-} (use: lint [path])"
            exit 1
            ;;
    esac
}

# Command: context
cmd_context() {
    # Dist auto-build and all subcommand logic live in mc-context.mjs
    node "$MC_DIR/scripts/mc-context.mjs" "$@"
}

cmd_version() {
    echo "Mission Control CLI v${VERSION}"
}

# Main
case "${1:-help}" in
    doctor)
        cmd_doctor
        ;;
    status)
        cmd_status
        ;;
    run)
        shift
        cmd_run "$@"
        ;;
    dispatch)
        shift
        cmd_dispatch "$@"
        ;;
    accept)
        shift
        cmd_accept "$@"
        ;;
    revision-history)
        shift
        cmd_revision_history "$@"
        ;;
    request-revision)
        shift
        cmd_request_revision "$@"
        ;;
    reopen)
        shift
        cmd_reopen "$@"
        ;;
    governance)
        shift
        cmd_governance "$@"
        ;;
    expired-approvals)
        shift
        cmd_expired_approvals "$@"
        ;;
    stale-evidence)
        shift
        cmd_stale_evidence "$@"
        ;;
    supersede)
        shift
        cmd_supersede "$@"
        ;;
    run-summary)
        shift
        cmd_run_summary "$@"
        ;;
    run-events)
        shift
        cmd_run_events "$@"
        ;;
    run-artifacts)
        shift
        cmd_run_artifacts "$@"
        ;;
    tasks)
        shift
        cmd_tasks "$@"
        ;;
    claim)
        cmd_claim
        ;;
    logs)
        shift
        cmd_logs "$@"
        ;;
    assess)
        shift
        if [[ -x "$MC_DIR/scripts/assess/mc-assess.sh" ]]; then
            "$MC_DIR/scripts/assess/mc-assess.sh" "$@"
        else
            log_error "scripts/assess/mc-assess.sh not found"
            exit 1
        fi
        ;;
    flags)
        shift
        cmd_flags "$@"
        ;;
    executor)
        shift
        cmd_executor "$@"
        ;;
    skill)
        shift
        cmd_skill "$@"
        ;;
    context)
        shift
        cmd_context "$@"
        ;;
    version|--version|-v)
        cmd_version
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        log_error "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
