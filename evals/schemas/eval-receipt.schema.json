{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mission-control.local/schemas/eval-receipt-v1.json",
  "title": "Mission Control Eval Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "idempotencyKey",
    "suite",
    "runStatus",
    "verdict",
    "publishable",
    "releaseBlocking",
    "acceptanceAuthority",
    "provenance",
    "metrics",
    "results",
    "regressions",
    "accountingErrors",
    "startedAt",
    "finishedAt",
    "receiptDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "mission-control/eval-receipt/v1" },
    "runId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "suite": { "$ref": "#/$defs/suiteIdentity" },
    "baseline": { "$ref": "#/$defs/baselineIdentity" },
    "runStatus": { "enum": ["QUEUED", "RUNNING", "COMPLETED", "FAILED", "CANCELED"] },
    "verdict": { "enum": ["PASS", "WARN", "FAIL", "INVALID"] },
    "publishable": { "type": "boolean" },
    "releaseBlocking": { "const": false },
    "acceptanceAuthority": { "const": false },
    "provenance": { "$ref": "#/$defs/provenance" },
    "metrics": { "$ref": "#/$defs/metrics" },
    "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/caseResult" } },
    "regressions": { "type": "array", "items": { "$ref": "#/$defs/regression" } },
    "accountingErrors": { "type": "array", "items": { "type": "string" } },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "receiptDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "suiteIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version", "digest"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "baselineIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineId", "digest"],
      "properties": {
        "baselineId": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "adapter", "runtime", "datasetDigest", "resolvedConfigDigest", "seed", "artifacts"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "baseRevision": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "digest"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "id", "version"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "promptDigest": { "$ref": "#/$defs/sha256" },
        "rubricDigest": { "$ref": "#/$defs/sha256" },
        "datasetDigest": { "$ref": "#/$defs/sha256" },
        "resolvedConfigDigest": { "$ref": "#/$defs/sha256" },
        "seed": { "type": "string", "minLength": 1 },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "assertionResult": {
      "type": "object",
      "required": ["code", "path", "operator", "passed"],
      "properties": {
        "code": { "type": "string" },
        "path": { "type": "string" },
        "operator": { "type": "string" },
        "passed": { "type": "boolean" },
        "observed": {},
        "expected": {}
      }
    },
    "caseResult": {
      "type": "object",
      "required": ["caseKey", "caseName", "severity", "slices", "verdict", "score", "assertionResults", "failedAssertionCodes", "evidenceRefs"],
      "properties": {
        "caseKey": { "type": "string", "minLength": 1 },
        "caseName": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["BLOCKING", "ADVISORY"] },
        "slices": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "verdict": { "enum": ["PASS", "FAIL", "INVALID", "SKIPPED"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "failureOrigin": { "enum": ["SYSTEM_UNDER_TEST", "HARNESS", "JUDGE", "DATA", "INFRASTRUCTURE"] },
        "assertionResults": { "type": "array", "items": { "$ref": "#/$defs/assertionResult" } },
        "failedAssertionCodes": { "type": "array", "items": { "type": "string" } },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } },
        "durationMs": { "type": "number", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 },
        "outputDigest": { "$ref": "#/$defs/sha256" },
        "error": { "type": "string" }
      }
    },
    "slice": {
      "type": "object",
      "required": ["slice", "cases", "passed", "failed", "invalid", "skipped", "passRate"],
      "properties": {
        "slice": { "type": "string" },
        "cases": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "invalid": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["totalCases", "scoredCases", "passedCases", "failedCases", "invalidCases", "skippedCases", "blockingCases", "blockingPassed", "advisoryCases", "advisoryPassed", "completionRate", "blockingPassRate", "advisoryPassRate", "invalidRatio", "totalDurationMs", "totalCostUsd", "slices"],
      "properties": {
        "totalCases": { "type": "integer", "minimum": 0 },
        "scoredCases": { "type": "integer", "minimum": 0 },
        "passedCases": { "type": "integer", "minimum": 0 },
        "failedCases": { "type": "integer", "minimum": 0 },
        "invalidCases": { "type": "integer", "minimum": 0 },
        "skippedCases": { "type": "integer", "minimum": 0 },
        "blockingCases": { "type": "integer", "minimum": 0 },
        "blockingPassed": { "type": "integer", "minimum": 0 },
        "advisoryCases": { "type": "integer", "minimum": 0 },
        "advisoryPassed": { "type": "integer", "minimum": 0 },
        "completionRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "blockingPassRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "advisoryPassRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "invalidRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "totalDurationMs": { "type": "number", "minimum": 0 },
        "totalCostUsd": { "type": "number", "minimum": 0 },
        "slices": { "type": "array", "items": { "$ref": "#/$defs/slice" } }
      }
    },
    "regression": {
      "type": "object",
      "required": ["scope", "key", "severity", "baseline", "candidate", "blocking"],
      "properties": {
        "scope": { "enum": ["CASE", "SLICE"] },
        "key": { "type": "string" },
        "severity": { "enum": ["BLOCKING", "ADVISORY"] },
        "baseline": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "candidate": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "blocking": { "type": "boolean" }
      }
    }
  }
}
