{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": "../..",
    "types": ["node"],
    "paths": {
      "@mission-control/coordinator": ["packages/coordinator/src/index.ts"],
      "@mission-control/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@mission-control/memory": ["packages/memory/src/index.ts"],
      "@mission-control/context-router": ["packages/context-router/src/index.ts"],
      "@mission-control/workflow-engine": ["packages/workflow-engine/src/index.ts"],
      "@mission-control/shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
