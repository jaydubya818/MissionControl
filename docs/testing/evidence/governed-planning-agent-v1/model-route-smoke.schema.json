{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "packageName", "headCommit"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS"]
    },
    "packageName": {
      "type": "string",
      "const": "mission-control"
    },
    "headCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
