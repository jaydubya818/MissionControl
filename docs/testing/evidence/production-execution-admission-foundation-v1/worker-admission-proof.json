  "serverValidation": "worker report is rejected unless every advertised value equals the canonical Factory Version",
  "admissionBoundaries": ["readiness", "routing preview", "dispatch", "verification scheduling", "Attempt claim"],
  "focusedTests": {
    "status": "PASS",
    "mismatchResult": "worker-factory-version-mismatch",
    "registrationMismatch": "factory-version-bindings-invalid or canonical configuration rejection"
  }
}
