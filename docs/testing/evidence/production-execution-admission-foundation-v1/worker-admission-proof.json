{
  "schema": "production-factory-worker-admission-proof/v1",
  "productionWorkerCount": 0,
  "productionAdmissionResult": "BLOCKED_MISSING_WORKER",
  "requiredExactMatch": [
    "factoryDefinitionVersionId",
    "factoryConfigurationDigest",
    "adapter",
    "version",
    "provider",
    "model",
    "capabilityManifestSha256",
    "effectiveConfigSha256",
    "executionBackend",
    "modelRouteDigest",
    "sandboxProfileDigest",
    "repositoryId"
