# Convex (set by `npx convex dev` in .env.local)
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_DEPLOY_KEY=your-deploy-key
CONVEX_URL=https://your-deployment.convex.cloud
# UI needs this (Vite exposes only VITE_* to client). Copy CONVEX_URL here after convex dev.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Human authentication rollout. Omit to preserve the existing legacy provider;
# select `clerk` only after configuring both values below. `demo` is local-only.
VITE_AUTH_MODE=legacy
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Replace the public placeholder in convex/auth.config.ts with the Clerk issuer
# when enabling Clerk. Convex requires auth-config env vars before compilation.
# One-time initial-owner recovery; remove both after bootstrap succeeds.
# Set these on the Convex deployment, not in Vite.
# MC_BOOTSTRAP_OWNER_SUBJECT=user_your_exact_clerk_user_id
# MC_BOOTSTRAP_TENANT_SLUG=your-company-slug
# ARM/legacy compatibility mode (true = legacy-pref reads, false = ARM instance-pref reads)
ARM_COMPAT_MODE=true

# API Server
API_PORT=3000
API_SECRET=your-api-secret-change-in-production
NODE_ENV=development

# Workers (legacy placeholders; not currently read by any Mission Control code.
# Worker concurrency is set by CODEX_WORKER_MAX_CONCURRENT_RUNS.)
WORKER_CONCURRENCY=5
HEARTBEAT_INTERVAL_MS=30000
LOOP_DETECTION_INTERVAL_MS=60000

# Orchestration server (optional; when set, /status, /tick, /agents/*, /gateway/status require Bearer token)
ORCHESTRATION_PORT=4100
ORCHESTRATION_API_TOKEN=
# MC_API_TOKEN=  # alternative to ORCHESTRATION_API_TOKEN
# Server-only JWT for a Convex service identity mapped to an active Mission
# Control operator. Never expose this through a VITE_* variable.
CONVEX_SERVICE_AUTH_TOKEN=
# GitHub PR/CI ingestion. Webhook ingestion is accepted only after HMAC
# verification; the API token is server-side and used to fetch checks/diffs.
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
GITHUB_TOKEN=

# Signed service-command boundary. Configure the same secret and service ID in
# the Convex deployment and orchestration server; never expose either to Vite.
MISSION_CONTROL_SERVICE_ID=orchestration-server
MISSION_CONTROL_SERVICE_COMMAND_SECRET=

# Unscoped compatibility mode. Do not enable it together with the bounded
# CODEX_FACTORY_WORKER_ENABLED production mode.
FACTORY_EXECUTION_ENABLED=0
FACTORY_EXECUTION_POLL_MS=15000
CODEX_EXECUTABLE=codex

# Durable, verification-first codex/v1 Factory worker. Keep disabled until the
# existing repository has a VERIFIED GitHub App installation and a current
# Factory assessment. The project/repository IDs bound the only claimable scope.
CODEX_FACTORY_WORKER_ENABLED=false
# Optional experimental DeepSeek Harness adapter. This does not bootstrap the
# checkout, Ollama, model, or credentials. The worker fails closed unless the
# exact evaluated source, built CLI, runtime, and model are already present.
DEEPSEEK_HARNESS_EXECUTOR_ENABLED=0
DEEPSEEK_HARNESS_ROOT=
CODEX_WORKER_PROJECT_ID=
CODEX_WORKER_REPOSITORY_ID=
CODEX_WORKER_CHECKOUT_ROOT=
CODEX_WORKER_HOST_ID=
CODEX_WORKER_MAX_CONCURRENT_RUNS=1
CODEX_WORKER_APPROVED_MODEL_IDS=
# JSON array of exact, server-created Factory Version attestations. Registration
# validates every digest and rejects entries outside CODEX_WORKER_REPOSITORY_ID.
CODEX_WORKER_FACTORY_VERSION_BINDINGS_JSON=
CODEX_WORKER_NETWORK_POLICY_STATUS=UNKNOWN
CODEX_WORKER_SECRET_POLICY_STATUS=UNKNOWN
# GitHub App publication identity; server-side only, never VITE_*.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional legacy-worker alternative to GITHUB_APP_PRIVATE_KEY.
GITHUB_APP_PRIVATE_KEY_FILE=

# Remote Sandbox (Preview; globally disabled). Configuration alone does not
# enable the backend — the project flag and Factory Version still gate it.
CODEX_WORKER_REMOTE_SANDBOX_ENABLED=0
# Absolute path to the dedicated exe.dev SSH identity (mode 0600).
EXEDEV_IDENTITY_FILE=
# OpenRouter management key used ONLY to mint and revoke short-lived
# Attempt-scoped inference credentials. Never exposed to a sandbox.
OPENROUTER_MANAGEMENT_API_KEY=

# GitHub App OAuth values used by the installation-connect flow.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=

# Operator UI origin. Scopes orchestration CORS and the Gateway WebSocket
# upgrade allowlist. Comma-separated for multiple origins.
MISSION_CONTROL_APP_URL=http://localhost:5173
# Orchestration URL the browser calls (Vite-exposed; not a secret).
# LEAVE UNSET IN LOCAL DEVELOPMENT. The Vite dev proxy is the only thing that
# injects `Authorization: Bearer ${ORCHESTRATION_API_TOKEN}` on /orchestration/*;
# setting this makes the browser call the server directly and every call 401s.
# Set it only when a reverse proxy in front of the orchestration server injects
# the bearer for you.
# VITE_ORCHESTRATION_URL=https://orchestration.example.com

# Model providers used by planning, PRD parsing, knowledge indexing, and voice.
# Set on the Convex deployment, not in Vite.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Stripe revenue webhook. The /stripe/webhook HTTP action fails closed with 503
# until this is set; signatures older than 5 minutes are rejected.
STRIPE_WEBHOOK_SECRET=

# Local inference base URLs (optional; used by the local model catalog sync).
# OLLAMA_BASE_URL=http://localhost:11434
# LM_STUDIO_BASE_URL=http://localhost:1234
# MLX_BASE_URL=http://localhost:8080
# VLLM_BASE_URL=http://localhost:8000

# Demo/canary switches. Leave unset outside a disposable environment.
# ALLOW_DEMO_SEEDING=true
# PHASE_ZERO_CANARY_ENABLED=true
# WORKFLOW_RECOVERY_CANARY_ENABLED=true
# MC_ALLOW_LOCAL_RELEASE_VERIFICATION=true
# DANGEROUS: grants every company permission over every tenant to an
# unauthenticated caller. Local demo only; never set this on a shared or
# production deployment.
# MC_ALLOW_ANONYMOUS_COMPANY_CONTEXT=1

# OpenClaw Gateway (URL can also be set in UI Gateway settings; token server-side only)
OPENCLAW_GATEWAY_URL=http://localhost:8080
GATEWAY_TOKEN=
# Convex env for discovery: set OPENCLAW_GATEWAY_TOKEN or GATEWAY_TOKEN to match

# Heartbeat recovery (Convex dashboard env). When set, stale-heartbeat cron runs.
# HEARTBEAT_RECOVERY_ENABLED=true
# HEARTBEAT_STALE_MINUTES=5
# HEARTBEAT_IGNORE_NEVER=true   # Skip agents that have never sent a heartbeat

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Slack (optional)
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Monitoring (optional; not currently read by any Mission Control code)
SENTRY_DSN=
LOG_LEVEL=info

# Budget Defaults (USD)
DEFAULT_INTERN_DAILY_BUDGET=2
DEFAULT_SPECIALIST_DAILY_BUDGET=5
DEFAULT_LEAD_DAILY_BUDGET=12
